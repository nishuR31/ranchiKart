# ── MudraKart API — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your actual values.

# Database (NeonDB PostgreSQL or any Postgres connection string)
DATABASE_URL=postgres://user:password@host.neon.tech/mudrakart?sslmode=require
DIRECT_URL=postgres://user:password@host.neon.tech/mudrakart?sslmode=require

# JWT secret — use a long random string (min 32 chars)
JWT_ACCESS_SECRET=...
JWT_ACCESS_EXPIRY

JWT_REFRESH_SECRET=...
JWT_REFRESH_EXPIRY

ADMIN_EMAIL

# Razorpay (get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID_TEST=xxx
RAZORPAY_KEY_SECRET_TEST=xxx

# SMTP (optional — for order confirmation emails)
SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-app-password"
SMTP_FROM="Your Brand <[EMAIL_ADDRESS]>"

BUSINESS_NAME="Your Brand"


# CORS — comma-separated allowed origins
CORS_ORIGIN=link,link
WEB_ORIGIN=link

# Server
PORT=3000
HOST=0.0.0.0
# NODE_ENV=production
NODE_ENV=development

#imgbb
IMGBB_API_KEY=...
IMGBB_API_URL=https://api.imgbb.com/1/upload

# REDIS_URL=redis://default:V15H71n3VUN9Hv2ONk1cafyJqUQP2yDd@attraction-hyperstable-earth-31321.db.redis.io:12274
REDIS_URL=redis://default:...

#google
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_CALLBACK_URL=...

EMAIL_TRANSPORT=gmail
# Image hosting (imgbb) — get your key at https://api.imgbb.com/

GMAIL_CLIENT_ID=....apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX--...
GMAIL_REFRESH_TOKEN=...
GMAIL_USER=...@mail.com
# GMAIL_ADDRESS=ranchikart@ranchi-kart.iam.gserviceaccount.com